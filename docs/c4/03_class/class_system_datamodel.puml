@startuml class_system_datamodel
title "Class Diagram System Datamodel"

namespace infrastructure {
  class TreeItem {
  -- Class identity --
  + {static} classId(): uuid
  + {abstract} typeId(): uuid
  -- Instance identity --
  - objectId: const uuid
  + objectId(): uuid
  -- Tree functions --
  + parentItem(): TreeItem
  + insertChild(index: int, child: TreeItem): void
  + removeChild(child: TreeItem): void
  + swapChild(old: TreeItem, new: TreeItem): void
  + childAt(index: int): TreeItem
  + size(): int
  + begin(): ChildIterator
  + end(): ChildIterator
  -- Signals --
  + childAboutToBeInserted(index: int, child: TreeItem): void
  + childInserted(index: int, child: TreeItem): void
  + childAboutToBeRemoved(index: int, child: TreeItem): void
  + childRemoved(index: int, child: TreeItem): void
  + subtreeChildAboutToBeInserted(parent: TreeItem, index: int, child: TreeItem): void
  + subtreeChildInserted(parent: TreeItem, index: int, child: TreeItem): void
  + subtreeChildAboutToBeRemoved(parent: TreeItem, index: int, child: TreeItem): void
  + subtreeChildRemoved(parent: TreeItem, index: int, child: TreeItem): void
  -- Protected hooks --
  # onAddedToParent(parent: TreeItem): void
  # onRemovedFromParent(): void
  }

  class ObjectRegistry {
  -- Registration --
  + registerObject(object: TreeItem): void
  + unregisterObject(id: uuid): void
  -- Lookup --
  + findObject(id: uuid): weak_ptr<TreeItem>
  + registeredCount(): int
  -- Signals --
  + objectRegistered(object: TreeItem): void
  .. note ..
  does not own objects (weak_ptr)
  auto-removes on QObject::destroyed
  }

  ObjectRegistry o-- "*" TreeItem

  class ObjectFactory {
  -- Management --
  + install(typeId: uuid, creator: Creator): bool
  + uninstall(typeId: uuid): bool
  + isInstalled(typeId: uuid): bool
  + installedCount(): int
  + installedTypes(): uuid[]
  -- Creation --
  + create(typeId: uuid, objectId: uuid): TreeItem
  + create(typeId: uuid): TreeItem
  .. note ..
  Creator = function<TreeItem(uuid)>
  }

  ObjectFactory ..> TreeItem : creates

  class ItemResolver {
  -- Identity --
  + {static} classId(): uuid
  + typeId(): uuid
  -- Accessors --
  + targetId(): uuid
  + isResolved(): bool
  .. note ..
  placeholder in the tree\nwaits for targetId in ObjectRegistry\nswaps itself out once target appears
  }

  TreeItem <|-- ItemResolver
  ItemResolver ..> ObjectRegistry : watches
  ItemResolver ..> TreeItem : swapsChild
}

class BaseObject {
-- Properties --
+ name : string
+ description : string
}
infrastructure.TreeItem <|-- BaseObject

enum Attribute {
    STRENGTH,
    DEXTERITY,
    INTELLIGENCE,
    HEALTH,
    HITS,
    WILL,
    PERCEPTION,
    FATIGUE,
    BASIC_SPEED,
    SPEED,
}
enum Difficulty {
    EASY,
    AVERAGE,
    HARD,
    VERY_HARD,
}

class Attribute {
+ cp(level: int): int
}
BaseObject <|-- Attribute

class SecondaryAttribute {
}
Attribute <|-- SecondaryAttribute

class Profession {

}
BaseObject <|-- Profession
class ProfessionContainer{

}
BaseObject <|-- ProfessionContainer
ProfessionContainer *-- "*" Profession
class Race {
    
}
BaseObject <|-- Race
class RaceContainer{

}
BaseObject <|-- RaceContainer
RaceContainer *-- "*" Race

class Advantage {    
+ cp(): int
}

BaseObject <|-- Advantage

class Skill {
-- Properties --
+ attribute: Attribute
+ difficulty: Difficulty
}
BaseObject <|-- Skill
Skill *-- Attribute
Skill *-- Difficulty

class SkillContainer
BaseObject <|-- SkillContainer
SkillContainer *-- "*" Skill
enum SpellType {
  AREA,
  REGULAR,
  BLOCKING,
  INFORMATION,
}

enum ResistedType {
  STRENGTH,
  DEXTERITY,
  INTELLIGENCE,
  HEALTH,
  HITS,
  WILL,
  PERCEPTION,
  ENEMY_SPELL,  
}
class Prerequisite {
+ {abstract}
}
class Spell {
-- Properties --
+ cost: int
+ maintenanceCost: int
+ timeToCast: Duration
+ duration: Duration
+ type: SpellType[]
+ resistedBy: ResistedType
+ prerequesites
}
Skill <|-- Spell
Spell *-- SpellType
Spell *-- ResistedType
class SpellContainer
BaseObject <|-- SpellContainer
SpellContainer *-- "*" Spell

class Psi {
}
BaseObject <|-- Psi
class PsiSkill

Skill <|-- PsiSkill
PsiSkill o-- Psi
Psi *-- "*" PsiSkill

class PsiContainer
BaseObject <|-- PsiContainer
PsiContainer *-- "*" Psi

enum ItemType {
    MELEE, 
    RANGED, 
    POTION, 
    BOLT, 
    OTHER,
}

class InventoryItem {
+ price: int
+ weight: int
}
BaseObject <|-- InventoryItem
InventoryItem *-- ItemType

class ItemContainer
BaseObject <|-- ItemContainer
ItemContainer *-- "*" InventoryItem

class Armor {
+ dr: [int, int]
}
InventoryItem <|-- Armor

enum DamagingType {
    SWING,
    THRUST,
}
enum DamageType {
    CRUSHING,
    CUTTING,
    IMPALING,
    PIERCING,
    SMALL_PIERCING,
    BURNING,
}

class Weapon {
+ damageAdding: int
}
InventoryItem <|-- Weapon
Weapon *-- DamagingType
Weapon *-- DamageType 

class Melee {
+ reach: int
+ parry: int
}
Weapon <|-- Melee

class Ranged {
+ acc: int
+ halfRange: int
+ maxRange: int    
}
Weapon <|-- Ranged

class Modifier {
+ {abstract} modify(value: int):int
}

BaseObject <|-- Modifier

class ConstantModifier {
+ value: int 
}
Modifier <|-- ConstantModifier

class ClampModifier {
+ minimum: int
+ maximum: int
}
Modifier <|-- ClampModifier

class DependentModifier {
}
Modifier <|-- DependentModifier
DependentModifier o-- BaseObject

note bottom of infrastructure.ItemResolver
  Concrete realisation of the ObjectResolver concept.
  Used during deserialisation when a referenced object
  has not yet been created.
end note

@enduml