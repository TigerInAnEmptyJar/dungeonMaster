@startuml class_system_datamodel
title "Class Diagram System Datamodel"

namespace infrastructure {
  class TreeItem {
  -- Class identity --
  + {static} classId(): uuid
  + {abstract} typeId(): uuid
  -- Instance identity --
  - objectId: const uuid
  + objectId(): uuid
  -- Tree functions --
  + parentItem(): TreeItem
  + insertChild(index: int, child: TreeItem): void
  + removeChild(child: TreeItem): void
  + swapChild(old: TreeItem, new: TreeItem): void
  + childAt(index: int): TreeItem
  + size(): int
  + begin(): ChildIterator
  + end(): ChildIterator
  -- Signals --
  + childAboutToBeInserted(index: int, child: TreeItem): void
  + childInserted(index: int, child: TreeItem): void
  + childAboutToBeRemoved(index: int, child: TreeItem): void
  + childRemoved(index: int, child: TreeItem): void
  + subtreeChildAboutToBeInserted(parent: TreeItem, index: int, child: TreeItem): void
  + subtreeChildInserted(parent: TreeItem, index: int, child: TreeItem): void
  + subtreeChildAboutToBeRemoved(parent: TreeItem, index: int, child: TreeItem): void
  + subtreeChildRemoved(parent: TreeItem, index: int, child: TreeItem): void
  -- Protected hooks --
  # onAddedToParent(parent: TreeItem): void
  # onRemovedFromParent(): void
  }

  class ObjectRegistry {
  -- Registration --
  + registerObject(object: TreeItem): void
  + unregisterObject(id: uuid): void
  -- Lookup --
  + findObject(id: uuid): weak_ptr<TreeItem>
  + registeredCount(): int
  -- Signals --
  + objectRegistered(object: TreeItem): void
  .. note ..
  does not own objects (weak_ptr)
  auto-removes on QObject::destroyed
  }

  ObjectRegistry o-- "*" TreeItem

  class ObjectFactory {
  -- Management --
  + install(typeId: uuid, creator: Creator): bool
  + uninstall(typeId: uuid): bool
  + isInstalled(typeId: uuid): bool
  + installedCount(): int
  + installedTypes(): uuid[]
  -- Creation --
  + create(typeId: uuid, objectId: uuid): TreeItem
  + create(typeId: uuid): TreeItem
  .. note ..
  Creator = function<TreeItem(uuid)>
  }

  ObjectFactory ..> TreeItem : creates

  class ItemResolver {
  -- Identity --
  + {static} classId(): uuid
  + typeId(): uuid
  -- Accessors --
  + targetId(): uuid
  + isResolved(): bool
  .. note ..
  placeholder in the tree\nwaits for targetId in ObjectRegistry\nswaps itself out once target appears
  }

  TreeItem <|-- ItemResolver
  ItemResolver ..> ObjectRegistry : watches
  ItemResolver ..> TreeItem : swapsChild
}

namespace gurps_system {
  class BaseObject {
  -- Identity --
  + {static} classId(): uuid
  + typeId(): uuid
  -- Properties --
  + name: QString
  + setName(name: QString): void
  + description: QString
  + setDescription(description: QString): void
  -- Signals --
  + nameChanged(name: QString): void
  + descriptionChanged(description: QString): void
  }

  abstract class Formula {
  -- Identity --
  + {static} classId(): uuid
  + {abstract} typeId(): uuid
  -- Properties --
  + maxDirectBonus(): int
  + setMaxDirectBonus(value: int): void
  -- Interface --
  + {abstract} levelBonus(investedCp: int): int
  + {abstract} cpCost(levelBonus: int): int
  -- Signals --
  + maxDirectBonusChanged(value: int): void
  }

  class LinearFormula {
  -- Identity --
  + {static} classId(): uuid
  + typeId(): uuid
  -- Properties --
  + costPerLevel(): int
  + setCostPerLevel(value: int): void
  -- Interface --
  + levelBonus(investedCp: int): int
  + cpCost(levelBonus: int): int
  .. note ..
  GURPS 4e: constant cost per level
  }

  class LookupFormula {
  -- Identity --
  + {static} classId(): uuid
  + typeId(): uuid
  -- Properties --
  + table(): CpTable
  + setTable(table: CpTable): void
  -- Interface --
  + levelBonus(investedCp: int): int
  + cpCost(levelBonus: int): int
  .. note ..
  GURPS 3e: non-linear lookup table
  CpTable = map<int,int>
  }

  gurps_system.Formula <|-- gurps_system.LinearFormula
  gurps_system.Formula <|-- gurps_system.LookupFormula

  class Attribute {
  -- Identity --
  + {static} classId(): uuid
  + typeId(): uuid
  -- Direct formula --
  + insertDirectFormula(formula: shared_ptr<Formula>): void
  + hasDirectFormula(): bool
  + directFormula(): Formula
  -- Derivation --
  + insertDerivationFormula(formula: shared_ptr<DerivationFormula>): void
  + derivationFormula(): DerivationFormula*
  + addParent(ref: shared_ptr<ParentRef>): void
  + parentCount(): int
  + parentAt(i: int): ParentRef
  .. note ..
  handbook definition only\nno per-character state\nchild layout: DerivationFormula, ParentRef[], Formula
  }

  gurps_system.BaseObject <|-- gurps_system.Attribute
  gurps_system.Attribute --> gurps_system.Formula
}

infrastructure.TreeItem <|-- gurps_system.BaseObject
infrastructure.TreeItem <|-- gurps_system.Formula

